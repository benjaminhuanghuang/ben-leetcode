{
  "compilerOptions": {
    "target": "esnext",
    "moduleDetection": "force",

    "module": "preserve",
    "moduleResolution": "bundler",

    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,

    "skipLibCheck": true,
    "types": ["vitest/globals"]
  }
}
